<mei meiversion="5.0" xmlns="http://www.music-encoding.org/ns/mei">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Gradual, northern France (Noyon?), 11th century; mass of St Agnes, f. 9v. Neume division, shapes, directions and facsimile zones: a close reading of the British Library's image of f. 9v (October 2026), in the Messine hand without a staff.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">GB-Lbl</idno>
            <idno type="shelfmark">Egerton MS 857</idno>
            <ptr target="https://iiif.bl.uk/uv/#?manifest=https://bl.digirati.io/iiif/ark:/81055/vdc_100056033063.0x000001"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Gradual, northern France (perhaps Noyon), 11th century; Lorraine (Messine) neumes without a staff. The gradual of St Agnes, f. 9v, on the last three lines of the page.</note>
            <note label="manuscript" type="title">Graduale</note>
            <note label="manuscript" type="transcription">Read sign by sign from the British Library's image of f. 9v, cut to the strip of the folio that holds the respond (IIIF region 0,4300,4874,1200), by two independent readers, October 2026; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
