  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Benedictine missal with notated chants for a church of St Ambrose in the province of Ravenna, 11th century; mass of St Agnes, f. 29v. Neume division, shapes, directions and facsimile zones: a close reading of the Walters' 300 dpi photograph of f. 29v (October 2026), in the central Italian hand without a staff.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">W.11</idno>
            <idno type="shelfmark">Baltimore, Walters Art Museum, W.11</idno>
            <ptr target="https://www.thedigitalwalters.org/Data/WaltersManuscripts/html/W11/"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Benedictine missal with notated chants for a church of St Ambrose in the province of Ravenna, 11th century. Central Italian neumes without a staff. The gradual of St Agnes, f. 29v.</note>
            <note label="manuscript" type="title">Missale</note>
            <note label="manuscript" type="transcription">Read sign by sign from the Walters' 300 dpi photograph of f. 29v by two independent readers, October 2026; the zones are on The Digital Walters' JPEG of the same photograph (1067 x 1800 px); see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
