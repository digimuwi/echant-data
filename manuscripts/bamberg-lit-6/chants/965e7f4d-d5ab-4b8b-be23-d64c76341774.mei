  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Gradual, Regensburg (St Emmeram), about 1000; mass for 1 January, f. 10v. Neume division, shapes, directions, significative letters, episemas and facsimile zones: a close reading of the Munich Digitization Center's image of f. 10v (November 2026), in the St Gall hand without a staff.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">D-BAs</idno>
            <idno type="shelfmark">Msc. Lit. 6</idno>
            <ptr target="https://www.digitale-sammlungen.de/view/bsb00140776?page=24"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Gradual from Regensburg (St Emmeram), about 1000; German neumes of the St Gall type without a staff, with significative letters and episemas. The gradual of the mass for 1 January, f. 10v.</note>
            <note label="manuscript" type="title">Graduale</note>
            <note label="manuscript" type="transcription">Read sign by sign from the Munich Digitization Center's image of f. 10v (2600 px wide), by two independent readers, October and November 2026; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
