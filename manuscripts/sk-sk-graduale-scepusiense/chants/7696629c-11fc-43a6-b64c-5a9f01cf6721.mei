  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Graduale Scepusiense, Spiš 1426; common of several virgins, ff. 178r-178v (pencil 96r-96v). Neume division, shapes and facsimile zones: a close reading of the Slovak Early Music Database photographs of ff. 178r-178v (October 2026), written in the hufnagel hand on the manuscript's five red lines with its C clef.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">SK-Sk</idno>
            <idno type="shelfmark">Graduale Scepusiense</idno>
            <ptr target="https://cantus.sk/source/6778"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Gradual of Spiš (Spišská Kapitula, Chapter Library), 1426; Gothic (German) notation on five red lines. The gradual in the Common of several Virgins, ff. 178r–178v (pencil foliation 96r–96v).</note>
            <note label="manuscript" type="title">Graduale Scepusiense</note>
            <note label="manuscript" type="transcription">Read note by note from the Slovak Early Music Database's photographs (SG_096r, SG_096v) by two independent readers, October 2026, and checked against the encodings already in eChant; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
