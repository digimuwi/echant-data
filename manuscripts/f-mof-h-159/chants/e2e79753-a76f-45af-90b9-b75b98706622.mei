    <body>
      <mdiv>
        <score>
          <scoreDef>
            <staffGrp>
              <staffDef lines="4" n="1" notationsubtype="french" notationtype="neume"/>
            </staffGrp>
          </scoreDef>
          <section>
            <staff>
              <layer>
                <pb facs="#surface-1" n="98r"/>
                <lb facs="#zone-line-1" n="1"/>
                <clef line="2" shape="C" xml:id="clef-clef2"/>
