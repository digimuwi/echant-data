  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Propter veritatem</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Transcription: Corpus Monodicum (Akademie der Wissenschaften und der Literatur Mainz / Universität Würzburg), document Mul 2-0290-4TR, https://stagedata.corpus-monodicum.de/mei/351c398d-18d9-4d0e-b3f2-383a37095bfd/Mul%202-0290-4TR.xml, corrected against the facsimile for eChant (see corpus-monodicum-corrected/corrections.md); © Corpus Monodicum. Pitches read an octave lower than there. The turn from f. 291v to 292r before the last syllable "a" is taken from the facsimile.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Propter veritatem</title>
            <idno type="siglum">F-MH</idno>
            <idno type="shelfmark">MS 2</idno>
            <ptr target="https://arca.irht.cnrs.fr/ark:/63955/md06g158f15n"/>
            <idno type="cantus-id">g01397a</idno>
            <note type="genre">Gradual verse</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Gradual of the Poor Clares of Mulhouse, 13th–14th century, with additions of the 15th–16th; square notation on four red lines (IRHT, Arca). The gradual stands on ff. 291r–292r, which Corpus Monodicum's images label 0289v, 0290, 0290v. Images: IRHT.</note>
            <note label="manuscript" type="transcription">Corpus Monodicum (Akademie der Wissenschaften und der Literatur Mainz / Universität Würzburg), document Mul 2-0289v-9TR, https://stagedata.corpus-monodicum.de/mei/f517be20-550c-4f28-ab92-fa51481bf994/Mul%202-0289v-9TR.xml (respond) and document Mul 2-0290-4TR, https://stagedata.corpus-monodicum.de/mei/351c398d-18d9-4d0e-b3f2-383a37095bfd/Mul%202-0290-4TR.xml (verse), corrected against the facsimile for eChant (see corpus-monodicum-corrected/corrections.md). Pitches read an octave lower than there.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
