<mei meiversion="5.0" xmlns="http://www.music-encoding.org/ns/mei">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Gradual of Gubbio, 12th century; ff. 3r-3v. Neume division, shapes and facsimile zones: a close reading of Gallica's images of ff. 3r-3v (October 2026), written in the central-italian hand on the manuscript's red F and yellow c lines, with two lines (D, a) added to make a four-line staff.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">F-Pn</idno>
            <idno type="shelfmark">NAL 1669</idno>
            <ptr target="https://gallica.bnf.fr/ark:/12148/btv1b525046487"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Gradual of Gubbio, 12th century; central Italian neumes on a red F line and a yellow c line. The gradual Diffusa est, ff. 3r-3v (the last system of f. 3r and the first two of f. 3v).</note>
            <note label="manuscript" type="title">Gradual of Gubbio</note>
            <note label="manuscript" type="transcription">Read note by note from Gallica's images (views 9 and 10) by two independent readers, October 2026; the syllables they read differently settled from the page by a third, and checked against the encodings already in eChant; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
