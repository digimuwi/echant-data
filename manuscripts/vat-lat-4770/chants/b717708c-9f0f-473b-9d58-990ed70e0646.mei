  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Missal with notated chants, central Italy (Abruzzi), late 10th or 11th century; octave of Christmas (1 January), f. 4r. Neume division, shapes, directions and facsimile zones: a close reading of the Vatican Library photograph of f. 4r (October 2026), in the central Italian hand without a staff.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">Vat. lat. 4770</idno>
            <idno type="shelfmark">Vatican City, Biblioteca Apostolica Vaticana, Vat. lat. 4770</idno>
            <ptr target="https://digi.vatlib.it/view/MSS_Vat.lat.4770"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Missal with notated chants, central Italy (Abruzzi), late 10th or 11th century. Central Italian neumes without a staff. The gradual of the octave of Christmas (1 January), f. 4r, left column.</note>
            <note label="manuscript" type="title">Missale</note>
            <note label="manuscript" type="transcription">Read sign by sign from the Vatican Library's photograph of f. 4r by two independent readers, October 2026; the neumes written on into the margin given to their syllables from the page and the other witnesses; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
