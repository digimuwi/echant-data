  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Diffusa est</title>
      </titleStmt>
      <pubStmt/>
      <notesStmt>
        <annot>Missale notatum Strigoniense (Esztergom use), 14th century; at the Circumcision, f. 17v, column b. Neume division, shapes and facsimile zones: a close reading of the Slovak Early Music Database photograph of f. 17v (October 2026), written in the messine-german hand on the manuscript's four lines with its F clef.</annot>
      </notesStmt>
      <sourceDesc>
        <source>
          <bibl>
            <title>Diffusa est</title>
            <idno type="siglum">SK-BRa</idno>
            <idno type="shelfmark">EC Lad. 3</idno>
            <ptr target="https://cantus.sk/source/16685"/>
            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Noted missal of Esztergom use, 14th century (Bratislava, Archív mesta Bratislavy); Hungarian (Esztergom) neumes on four red lines. The gradual at the Circumcision, f. 17v, column b.</note>
            <note label="manuscript" type="title">Missale notatum Strigoniense</note>
            <note label="manuscript" type="transcription">Read note by note from the Slovak Early Music Database's photograph (cantus.sk image 17049) by two independent readers, October 2026, and checked against the encodings already in eChant; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
      </sourceDesc>
    </fileDesc>
  </meiHead>
