            <idno type="cantus-id">g01397</idno>
            <note type="genre">Gradual</note>
            <note type="mode">5</note>
            <note label="manuscript" type="description">Missal of Sarum use, 13th century, England (Paris, Bibliothèque de l'Arsenal); square notation on four red lines. The gradual in the Common of one Virgin Martyr, f. 205r.</note>
            <note label="manuscript" type="title">Sarum missal</note>
            <note label="manuscript" type="transcription">Read note by note from Gallica's image (view 421) by two independent readers, October 2026, and checked against the encodings already in eChant; see research/diffusa-est/staff-readings/README.md.</note>
          </bibl>
        </source>
